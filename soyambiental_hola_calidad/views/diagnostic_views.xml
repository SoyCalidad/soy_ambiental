<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sga_hola_calidad_clause_tree" model="ir.ui.view">
        <field name="name">sga.hola_calidad.clause.tree</field>
        <field name="model">sga.hola_calidad.clause</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="question" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="sga_hola_calidad_requirement_tree" model="ir.ui.view">
        <field name="name">sga.hola_calidad.requirement.tree</field>
        <field name="model">sga.hola_calidad.requirement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="position_excel"/>
            </tree>
        </field>
    </record>

    <record id="sga_hola_calidad_diagnostic_tree" model="ir.ui.view">
        <field name="name">sga.hola_calidad.diagnostic.tree</field>
        <field name="model">sga.hola_calidad.diagnostic</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_diagnostic"/>
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="sga_hola_calidad_diagnostic_line_form" model="ir.ui.view">
        <field name="name">sga.hola_calidad.diagnostic.line.form</field>
        <field name="model">sga.hola_calidad.diagnostic.line</field>
        <field name="arch" type="xml">
            <form string="Detalle de linea">
                <group>
                    <field name="requirement_id"/>
                    <field name="qualification"/>
                    <field name="observation"/>
                    <control>
                        <create name="add_section_control" string="Add a section" context="{'default_is_page': True}"/>
                        <create name="add_question_control" string="Add a question"/>
                    </control>
                    <field name="info"/>
                </group>
            </form>
        </field>
    </record>

