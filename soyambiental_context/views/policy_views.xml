<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="context_policy_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.context.policy.view.form</field>
        <field name="model">mgmtsystem.context.policy</field>
        <field name="inherit_id" ref="mgmtsystem_context.context_policy_view_form"/>
        <field name="arch" type="xml">
            <page name="document" position="inside">
                <group attrs="{'invisible': [('system_id', '!=', %(soyambiental_context.policy_system_sga)d)]}">
                    <field name="sga_organization_context" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_direction_help" attrs="{'readonly': [('state','in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_env_protection_commitment" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_legal_req" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_standard_commitment" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_continuous_improvement" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_env_goals" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                    <field name="sga_communication" attrs="{'readonly': [('state', 'in', ('validate_ok', 'cancel'))]}"/>
                </group>
            </page>
        </field>
    </record>

    <record id="policy_template_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.context.policy.template.view.form</field>
        <field name="model">mgmtsystem.context.policy.template</field>
        <field name="inherit_id" ref="mgmtsystem_context.policy_template_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <group attrs="{'invisible': [('system_id', '!=', %(soyambiental_context.policy_system_sga)d)]}">
                    <field name="sga_organization_context"/>
                    <field name="sga_direction_help"/>
                    <field name="sga_env_protection_commitment"/>
                    <field name="sga_legal_req"/>
                    <field name="sga_standard_commitment"/>
                    <field name="sga_continuous_improvement"/>
                    <field name="sga_env_goals"/>
                    <field name="sga_communication"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
