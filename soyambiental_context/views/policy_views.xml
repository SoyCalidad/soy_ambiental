<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="context_policy_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.context.policy.view.form</field>
        <field name="model">mgmtsystem.context.policy</field>
        <field name="inherit_id" ref="mgmtsystem_context.context_policy_view_form"/>
        <field name="arch" type="xml">
            <page name="document" position="inside">
	            <group invisible="system_id != '%(soyambiental_context.policy_system_sga)d)'">
                    <field name="sga_organization_context" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_direction_help" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_env_protection_commitment" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_legal_req" readonly="state in ('valsidate_ok', 'cancel')"/>
                    <field name="sga_standard_commitment" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_continuous_improvement" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_env_goals" readonly="state in ('validate_ok', 'cancel')"/>
                    <field name="sga_communication" readonly="state in ('validate_ok', 'cancel')"/>
                </group>
            </page>
        </field>
    </record>

    <record id="policy_template_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.context.policy.template.view.form</field>
        <field name="model">mgmtsystem.context.policy.template</field>
        <field name="inherit_id" ref="mgmtsystem_context.policy_template_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <group invisible="system_id != '%(soyambiental_context.policy_system_sga)d)'">
                    <field name="sga_organization_context"/>
                    <field name="sga_direction_help"/>
                    <field name="sga_env_protection_commitment"/>
                    <field name="sga_legal_req"/>
                    <field name="sga_standard_commitment"/>
                    <field name="sga_continuous_improvement"/>
                    <field name="sga_env_goals"/>
                    <field name="sga_communication"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
