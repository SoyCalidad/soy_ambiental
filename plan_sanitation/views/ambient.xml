<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="am_ambient_view_form" model="ir.ui.view">
        <field name="name">am.ambient.view.form</field>
        <field name="model">am.ambient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="area_responsible" />
                        <field name="job" />
                        <field name="final_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="am_ambient_view_tree" model="ir.ui.view">
        <field name="name">am.ambient.view.tree</field>
        <field name="model">am.ambient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="area_responsible" />
                <field name="job" />
                <field name="final_date" />
            </list>
        </field>
    </record>
    <record id="am_ambient_action" model="ir.actions.act_window">
        <field name="name">Ambientes</field>
        <field name="res_model">am.ambient</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <h1>Ambientes</h1>
        </field>
    </record>
    

</odoo>
