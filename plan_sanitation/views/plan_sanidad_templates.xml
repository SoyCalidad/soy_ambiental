<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="principal_programa_ambiental" model="ir.ui.view">
        <field name="name">programa.ambiental.inherit.view.form</field>
        <field name="model">programa.ambiental</field>
        <field name="inherit_id" ref="plan_sanitation.programa_ambiental_view_form"/>
        <field name="priority">1000</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form position="inside">
                <footer position="replace">
                    <button name="action_save_programa_ambiental" class="btn btn-primary" type="object" string="Crear" />
                    <button special="cancel" string="Cancelar" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_principal_programa_ambiental" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Vista principal de programa ambiental</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="res_model">programa.ambiental</field>
        <field name="view_id" ref="plan_sanitation.principal_programa_ambiental"/>
    </record>

    <record id="principal_plan_ambiental" model="ir.ui.view">
        <field name="name">plan.ambiental.inherit.view.form</field>
        <field name="model">plan.ambiental</field>
        <field name="inherit_id" ref="plan_sanitation.plan_ambiental_view_form"/>
        <field name="priority">1000</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form position="inside">
                <footer position="replace">
                    <button name="action_save_plan_ambiental" class="btn btn-primary" type="object" string="Crear" />
                    <button special="cancel" string="Cancelar" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_principal_plan_ambiental" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Vista principal de plan ambiental</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="res_model">plan.ambiental</field>
        <field name="view_id" ref="plan_sanitation.principal_plan_ambiental"/>
    </record>
</odoo>
