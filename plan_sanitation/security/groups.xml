<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_sanitation" model="ir.module.category">
            <field name="name">Soy Sanidad</field>
            <field name="description">Accesos para módulo Plan de sanidad</field>
            <field name="parent_id" ref="hola_calidad.module_mgmt_management"/>
            <field name="sequence">49</field>
        </record>

        <record id="group_sanitation_onlyread" model="res.groups">
            <field name="name">Usuario: Solo lectura</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="plan_sanitation.module_sanitation"/>
        </record>

        <record id="group_sanitation_onlyread_printreport" model="res.groups">
            <field name="name">Usuario interno: Lectura e impresión</field>
            <field name="implied_ids" eval="[(4, ref('plan_sanitation.group_sanitation_onlyread'))]"/>
            <field name="category_id" ref="plan_sanitation.module_sanitation"/>
        </record>

        <record id="group_sanitation_write_printreport" model="res.groups">
            <field name="name">Usuario secundario: Lectura Edición de documentos propios</field>
            <field name="implied_ids" eval="[(4, ref('plan_sanitation.group_sanitation_onlyread_printreport'))]"/>
            <field name="category_id" ref="plan_sanitation.module_sanitation"/>
        </record>

        <record id="group_sanitation_all" model="res.groups">
            <field name="name">Responsable: Lectura y edición</field>
            <field name="implied_ids" eval="[(4, ref('plan_sanitation.group_sanitation_write_printreport'))]"/>
            <field name="category_id" ref="plan_sanitation.module_sanitation"/>
        </record>

    </data>

</odoo>
