<odoo>
    <record model="ir.rule" id="programa_ambiental_company_rule">
        <field name="name">Program de saneamiento ambiental: multi-company</field>
        <field name="model_id" ref="model_programa_ambiental" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>