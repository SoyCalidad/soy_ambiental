<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_plan_ambiental" model="mail.template">
            <field name="name">Plan ambiental: Enviar por correo electrónico</field>
            <field name="model_id" ref="plan_sanitation.model_plan_ambiental"/>
            <field name="email_from">
                {{ object.company_id.email_formatted or user.email_formatted }}
            </field>
            <field name="email_to">
                {{ object.user_responsible.login }}
            </field>
            <field name="subject">
                {{ object.company_id.name }} Plan ambiental (Ref {{ object.name or 'n/a' }})
            </field>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <p style="font-size:13px; margin:0; padding:0;">
                        Estimado/a
                        <t t-if="object.user_responsible.parent_id">
                            <t t-out="object.user_responsible.name or ''"/> (<t t-out="object.user_responsible.parent_id.name or ''"/>),
                        </t>
                        <t t-else="">
                            <t t-out="object.user_responsible.name or ''"/>,
                        </t>
                        <br/><br/>
                        Aquí se le envía el plan ambiental.
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('plan_sanitation.plan_ambiental_report_action'))]"/>
            <field name="lang">{{ object.user_responsible.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
