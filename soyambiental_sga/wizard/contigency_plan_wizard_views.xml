<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sga_contigency_plan_wizard_view_form" model="ir.ui.view">
        <field name="name">sga.contigency_plan.wizard.view.form</field>
        <field name="model">sga.contigency_plan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="contigency_plan_ids" required="1"/>
                </group>
                <footer>
                    <button name="action_export_pdf" string="PDF" type="object" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sga_contigency_plan_wizard_action" model="ir.actions.act_window">
        <field name="name">Asistente de Plan de contingencia</field>
        <field name="res_model">sga.contigency_plan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
