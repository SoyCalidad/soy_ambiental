<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="programa_ambiental_view_form" model="ir.ui.view">
        <field name="name">programa.ambiental.view.form.inherit</field>
        <field name="model">programa.ambiental</field>
        <field name="inherit_id" ref="plan_sanitation.programa_ambiental_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="replace">
                <h1>
                    <field name="code"/>
                </h1>
                <div class="oe_title">
                    <label for="name"/>
                    <h2>
                        <field name="name"/>
                    </h2>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
