<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sga_matrix_stage_process_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.stage_process.view.form</field>
        <field name="model">sga.matrix.stage_process</field>
        <field name="arch" type="xml">
            <form string="Proceso">
                <sheet>
                    <group>
                        <field name="stage_id"/>
                        <field name="activity_id"/>
                        <field name="task_id"/>
                        <field name="job_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_stage_process_view_tree" model="ir.ui.view">
        <field name="name">sga.matrix.stage_process.view.tree</field>
        <field name="model">sga.matrix.stage_process</field>
        <field name="arch" type="xml">
            <tree string="Proceso">
                <field name="stage_id"/>
                <field name="activity_id"/>
                <field name="task_id"/>
                <field name="job_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="sga_matrix_stage_process_action" model="ir.actions.act_window">
        <field name="name">Proceso</field>
        <field name="res_model">sga.matrix.stage_process</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea etapas</p>
        </field>
    </record>

    <record id="sga_matrix_stage_task_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.stage.task.view.form</field>
        <field name="model">sga.matrix.stage.task</field>
        <field name="arch" type="xml">
            <form string="Tarea">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="job_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_stage_task_view_tree" model="ir.ui.view">
        <field name="name">sga.matrix.stage.task.view.tree</field>
        <field name="model">sga.matrix.stage.task</field>
        <field name="arch" type="xml">
            <tree string="Actividad" editable="bottom">
                <field name="name"/>
                <field name="job_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="sga_matrix_stage_task_action" model="ir.actions.act_window">
        <field name="name">Tarea</field>
        <field name="res_model">sga.matrix.stage.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Tarea</p>
        </field>
    </record>

    <record id="sga_matrix_stage_activity_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.stage.activity.view.form</field>
        <field name="model">sga.matrix.stage.activity</field>
        <field name="arch" type="xml">
            <form string="Actividad">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_stage_activity_view_tree" model="ir.ui.view">
        <field name="name">sga.matrix.stage.activity.view.tree</field>
        <field name="model">sga.matrix.stage.activity</field>
        <field name="arch" type="xml">
            <tree string="Actividad">
                <field name="name"/>
                <field name="task_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="sga_matrix_stage_activity_action" model="ir.actions.act_window">
        <field name="name">Actividad</field>
        <field name="res_model">sga.matrix.stage.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Actividad</p>
        </field>
    </record>

    <record id="sga_matrix_stage_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.stage.view.form</field>
        <field name="model">sga.matrix.stage</field>
        <field name="arch" type="xml">
            <form string="Etapa">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="activity_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_stage_view_tree" model="ir.ui.view">
        <field name="name">sga.matrix.stage.view.tree</field>
        <field name="model">sga.matrix.stage</field>
        <field name="arch" type="xml">
            <tree string="Etapa">
                <field name="name"/>
                <field name="activity_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="sga_matrix_stage_action" model="ir.actions.act_window">
        <field name="name">Etapa</field>
        <field name="res_model">sga.matrix.stage</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Etapa</p>
        </field>
    </record>

    <record id="sga_matrix_process_2_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.process.view.form</field>
        <field name="model">sga.matrix.process</field>
        <field name="arch" type="xml">
            <form string="Proceso completo de la matriz SGA">
                <sheet>
                    <group>
                        <field name="stage_id"/>
                        <field name="activity_id"/>
                        <field name="task_id"/>
                        <field name="job_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="aspect_ids" widget="many2many_tags"/>
                        <field name="impact_ids" widget="many2many_tags"/>
                        <field name="legal_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_process_3_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.process.view.form</field>
        <field name="model">sga.matrix.process</field>
        <field name="arch" type="xml">
            <form string="Proceso completo de la matriz SGA">
                <sheet>
                    <group>
                        <field name="stage_id"/>
                        <field name="activity_id"/>
                        <field name="task_id"/>
                        <field name="job_ids" widget="many2many_tags"/>
                        <field name="aspect_ids" widget="many2many_tags"/>
                        <field name="impact_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page name="evaluation_ids" string="Evaluación">
                            <group>
                                <field name="evaluation_ids">
                                    <tree editable="bottom">
                                        <field name="evaluation_item_id"/>
                                        <field name="criterio_readonly" column_invisible="1"/>
                                        <field name="evaluation_item_criterio_id" readonly="criterio_readonly"/>
                                        <field name="evaluation_value_id"/>
                                    </tree>
                                </field>
                            </group>
                            <group>
                                <field name="evaluation_p"/>
                                <field name="evaluation_c"/>
                                <field name="evaluation_pxc"/>
                                <field name="level"/>
                                <field name="process_id"/>
                                <field name="interpretation"/>
                            </group>
                        </page>
                        <page name="risk_opp" string="Riesgos y oportunidades">
                            <separator string="Riesgos"/>
                            <field name="risk_ids"/>
                            <separator string="Oportunidades"/>
                            <field name="opp_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_process_4_view_form" model="ir.ui.view">
        <field name="name">sga.matrix.process.view.form</field>
        <field name="model">sga.matrix.process</field>
        <field name="arch" type="xml">
            <form string="Proceso completo de la matriz SGA">
                <sheet>
                    <group>
                        <field name="stage_id"/>
                        <field name="activity_id"/>
                        <field name="task_id"/>
                        <field name="job_ids" widget="many2many_tags"/>
                        <field name="aspect_ids" widget="many2many_tags"/>
                        <field name="impact_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page name="evaluation_ids" string="Evaluación">
                            <group>
                                <field name="evaluation_ids">
                                    <tree editable="bottom">
                                        <field name="evaluation_item_id"/>
                                        <field name="criterio_readonly" column_invisible="1"/>
                                        <field name="evaluation_item_criterio_id" readonly="criterio_readonly"/>
                                        <field name="evaluation_value_id"/>
                                    </tree>
                                </field>
                            </group>
                            <group>
                                <field name="evaluation_p"/>
                                <field name="evaluation_c"/>
                                <field name="evaluation_pxc"/>
                                <field name="level"/>
                                <field name="process_id"/>
                                <field name="interpretation"/>
                            </group>
                        </page>
                        <page name="control_ids" string="Control">
                            <group>
                                <field name="action_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="type_action_id"/>
                                        <field name="user_id" string="Responsable de ejecución"/>
                                    </tree>
                                </field>
                            </group>
                            <group>
                                <field name="reevaluation_ids">
                                    <tree editable="bottom">
                                        <field name="evaluation_item_id"/>
                                        <field name="evaluation_value_id"/>
                                    </tree>
                                </field>
                            </group>
                            <group>
                                <field name="control_p"/>
                                <field name="control_c"/>
                                <field name="control_pxc"/>
                                <field name="control_level"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_matrix_process_view_tree" model="ir.ui.view">
        <field name="name">sga.matrix.process.view.tree</field>
        <field name="model">sga.matrix.process</field>
        <field name="arch" type="xml">
            <tree string="Proceso completo de la matriz SGA">
                <field name="task_id"/>
                <field name="job_ids" widget="many2many_tags"/>
                <field name="impact_ids" widget="many2many_tags"/>
                <field name="legal_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
</odoo>
