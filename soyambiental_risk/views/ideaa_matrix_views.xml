<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sga_ideaa_matrix_view_form" model="ir.ui.view">
        <field name="name">sga.ideaa_matrix.view.form</field>
        <field name="model">sga.ideaa_matrix</field>
        <field name="arch" type="xml">
            <form string="Matriz">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok,cancel"/>
                    <button string="Enviar a Revisar"
                            name="send_review"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'elaborate'"/>
                    <button string="Enviar a Validar"
                            name="send_validate"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'review'"/>
                    <button string="Validar"
                            name="send_validate_ok"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'validate'"/>
                    <button string="Volver Obsoleto"
                            name="send_cancel"
                            type="object"
                            class="btn-second"
                            invisible="state == 'cancel'"/>
                    <button name="button_new_version"
                            type="object"
                            string="Nueva versión"
                            class="oe_highlight"
                            invisible="state != 'validate_ok'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_older_versions"
                                class="oe_stat_button"
                                icon="fa-archive"
                                style="white-space: nowrap;"
                                invisible="version==1"
                                string="Versiones antiguas"/>
                        
                    </div>
                    <label for="code" />
                    <h3>
                        <field name="code" />

                    </h3>
                    <label for="name"/>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <field name="lines_locked" invisible="1"/>
                    <notebook>
                        <page name="data" string="DATOS">
                            <group string="IDENTIFICACIÓN DE ACTIVIDADES">
                                <group>
                                    <field name="eval_stage" readonly="lines_locked"/>
                                    <field name="eval_activity" readonly="lines_locked"/>
                                </group>
                                <group>
                                    <field name="eval_process" readonly="lines_locked"/>
                                </group>
                            </group>
                            <group string="IDENTIFICACIÓN AMBIENTAL">
                                <group>
                                    <field name="eval_aspect" readonly="lines_locked"/>
                                    <field name="eval_condition" readonly="lines_locked"/>
                                </group>
                                <group>
                                    <field name="eval_impact" readonly="lines_locked"/>
                                </group>
                            </group>
                            <group string="CONTROLES">
                                <field name="eval_controls" readonly="lines_locked"/>
                            </group>
                            <group string="EVALUACIÓN">
                                <group>
                                    <field name="eval_frequency" readonly="lines_locked"/>
                                    <field name="eval_severity" readonly="lines_locked"/>
                                    <field name="eval_scope" readonly="lines_locked"/>
                                </group>
                                <group>
                                    <field name="eval_impact_level"/>
                                    <field name="eval_significance"/>
                                </group>
                            </group>
                            <group string="MEDIDAS DE CONTROL A IMPLEMENTAR">
                                <field name="eval_action_ids" nolabel="1" colspan="2" readonly="lines_locked">
                                    <list>
                                        <field name="reference"/>
                                        <field name="name" string="Título"/>
                                        <field name="type_action_id"/>
                                        <field name="exec_hr_resp_ids" widget="many2many_tags"/>
                                        <field name="track_user_id"/>
                                        <field name="date_deadline"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </group>
                            <div class="d-flex">
                                <button class="btn btn-primary"
                                        type="object"
                                        name="action_add_line"
                                        string="Agregar"
                                        invisible="lines_locked"/>
                            </div>
                        </page>
                        <page name="matrix" string="MATRIZ">
                            <field name="line_ids"
                                   nolabel="1"
                                   readonly="lines_locked"
                                   context="{'form_view_ref': 'soyambiental_risk.sga_ideaa_matrix_line_view_form'}">
                                <list create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage"/>
                                    <field name="process"/>
                                    <field name="activity"/>
                                    <field name="aspect"/>
                                    <field name="impact"/>
                                    <field name="condition"/>
                                    <field name="controls"/>
                                    <field name="frequency"/>
                                    <field name="severity"/>
                                    <field name="scope"/>
                                    <field name="impact_level"/>
                                    <field name="significance"
                                           widget="badge"
                                           decoration-danger="significance == 'significant'"
                                           decoration-success="significance == 'not_significant'"/>
                                    <field name="action_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page name="version_info" string="Validación y versión">
                            <group col="4">
                                <group colspan="4">
                                    <field name="version" readonly="state in ('validate_ok','cancel')"/>
                                </group>
                                <group colspan="4">
                                    <separator string="Elaboración"/>
                                    <field name="elaboration_step" colspan="2" nolabel="1" readonly="state != 'elaborate'"/>
                                    <separator string="Revisión"/>
                                    <field name="review_step" colspan="2" nolabel="1" readonly="state not in ('elaborate', 'review')"/>
                                    <separator string="Validación"/>
                                    <field name="validation_step" colspan="2" nolabel="1" readonly="state not in ('elaborate', 'review', 'validate')"/>
                                </group>
                                <group colspan="2">
                                    <field name="date_elaborate" required="state == 'elaborate'" readonly="1"/>
                                    <field name="date_review" required="state == 'review'" readonly="1" invisible="state == 'elaborate'"/>
                                    <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ('elaborate', 'review')"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sga_ideaa_matrix_line_view_form" model="ir.ui.view">
        <field name="name">sga.ideaa_matrix.line.view.form</field>
        <field name="model">sga.ideaa_matrix.line</field>
        <field name="arch" type="xml">
            <form string="Línea de la matriz">
                <sheet>
                    <group string="IDENTIFICACIÓN DE ACTIVIDADES">
                        <group>
                            <field name="stage"/>
                            <field name="activity"/>
                        </group>
                        <group>
                            <field name="process"/>
                        </group>
                    </group>
                    <group string="IDENTIFICACIÓN AMBIENTAL">
                        <group>
                            <field name="aspect"/>
                            <field name="condition"/>
                        </group>
                        <group>
                            <field name="impact"/>
                        </group>
                    </group>
                    <group string="CONTROLES">
                        <field name="controls"/>
                    </group>
                    <group string="EVALUACIÓN">
                        <group>
                            <field name="frequency"/>
                            <field name="severity"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="impact_level"/>
                            <field name="significance"/>
                        </group>
                    </group>
                    <group string="MEDIDAS DE CONTROL A IMPLEMENTAR">
                        <field name="action_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="reference"/>
                                <field name="name" string="Título"/>
                                <field name="type_action_id"/>
                                <field name="exec_hr_resp_ids" widget="many2many_tags"/>
                                <field name="track_user_id"/>
                                <field name="date_deadline"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sga_ideaa_matrix_view_tree" model="ir.ui.view">
        <field name="name">sga.ideaa_matrix.view.tree</field>
        <field name="model">sga.ideaa_matrix</field>
        <field name="arch" type="xml">
            <list string="Matriz">
                <field name="name"/>
                <field name="state"/>
                <field name="date_elaborate"/>
                <field name="elaboration_step" widget="many2many_tags"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="sga_ideaa_matrix_action" model="ir.actions.act_window">
        <field name="name">Matriz IDEAA</field>
        <field name="res_model">sga.ideaa_matrix</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                MATRIZ DE IDENTIFICACIÓN DE ASPECTOS AMBIENTALES
            </p>
        </field>
    </record>
</odoo>
