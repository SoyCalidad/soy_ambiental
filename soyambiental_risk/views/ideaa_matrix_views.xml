<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sga_ideaa_matrix_view_form" model="ir.ui.view">
        <field name="name">sga.ideaa_matrix.view.form</field>
        <field name="model">sga.ideaa_matrix</field>
        <field name="arch" type="xml">
            <form string="Matriz">
                <header>
                    <field name="matrix_state" widget="statusbar" attrs="{'invisible':[('state','!=','elaborate')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok"
                           attrs="{'invisible':[('state','=','elaborate')]}"/>
                    <button string="Validar proceso"
                            name="init_preparation"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('matrix_state','!=', 'draft')]}"/>
                    <button string="Identificar aspectos e impactos"
                            name="action_identify_aspect_impact"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('matrix_state','!=', 'process')]}"/>
                    <button string="Evaluar impactos"
                            name="evaluate_impacts"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('matrix_state','!=', 'identification')]}"/>
                    <button string="Establecer controles"
                            name="controlate_risks"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('matrix_state','!=', 'evaluation')]}"/>
                    <button string="Enviar a Revisar"
                            name="send_review"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':['|', ('matrix_state','!=', 'control'), ('state','!=', 'elaborate')]}"/>
                    <button string="Enviar a Validar"
                            name="send_validate"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('state','not in', ('review'))]}"/>
                    <button string="Validar"
                            name="send_validate_ok"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('state','not in', ('validate'))]}"/>
                    <button string="Volver Obsoleto"
                            name="send_cancel"
                            type="object"
                            class="btn-second"
                            attrs="{'invisible': [('state','in',('cancel'))] }"/>
                    <button name="button_new_version"
                            type="object"
                            string="Nueva versión"
                            class="oe_highlight"
                            attrs="{'invisible': [('state','not in',('validate_ok'))] }"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_older_versions"
                                class="oe_stat_button"
                                icon="fa-archive"
                                style="white-space: nowrap;"
                                string="Versiones antiguas"/>
                        <button name="action_open_survey" type="object" class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="survey_count" widget="statinfo" string="Encuestas"/>
                        </button>
                    </div>
                    <label for="name"/>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <notebook>
                        <page name="stage" string="Etapas">
                            <field name="stage_ids"
                                   context="{'form_view_ref':'soyambiental_risk.sga_matrix_stage_view_form'}">
                                <tree>
                                    <field name="name"/>
                                    <field name="activity_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page name="process" string="Proceso">
                            <field name="stage_process_ids"
                                   context="{'form_view_ref':'soyambiental_risk.sga_matrix_stage_process_view_form'}">
                                <tree editable="bottom">
                                    <field name="stage_id"/>
                                    <field name="activity_id"/>
                                    <field name="task_id"/>
                                    <field name="job_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page name="process_aspect_impact" string="Aspectos e impactos">
                            <field name="process_aspect_impact_ids">
                                <tree editable="bottom">
                                    <field name="task_id"/>
                                    <field name="job_ids" widget="many2many_tags"/>
                                    <field name="aspect_ids" widget="many2many_tags"/>
                                    <field name="impact_ids" widget="many2many_tags"/>
                                    <field name="legal_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page name="process_evaluation" string="Evaluación de impactos">
                            <group>
                                <field name="evaluation_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            </group>
                            <group>
                                <field name="process_evaluation_ids"
                                       context="{'form_view_ref':'soyambiental_risk.sga_matrix_process_3_view_form'}">
                                    <tree string="Evaluación de impactos">
                                        <field name="job_ids" widget="many2many_tags"/>
                                        <field name="aspect_ids" widget="many2many_tags"/>
                                        <field name="impact_ids" widget="many2many_tags"/>
                                        <field name="evaluation_p"/>
                                        <field name="evaluation_c"/>
                                        <field name="evaluation_pxc"/>
                                        <field name="level"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page name="process_control" string="Controles">
                            <field name="process_control_ids"
                                   context="{'form_view_ref': 'soyambiental_risk.sga_matrix_process_4_view_form'}">
                                <tree>
                                    <field name="job_ids" widget="many2many_tags"/>
                                    <field name="aspect_ids" widget="many2many_tags"/>
                                    <field name="impact_ids" widget="many2many_tags"/>
                                    <field name="control_p"/>
                                    <field name="control_c"/>
                                    <field name="control_pxc"/>
                                    <field name="control_level"/>
                                </tree>
                            </field>
                        </page>
                        <page name="survey_ids" string="Encuestas">
                            <field name="survey_ids" 
                            domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" />
                        </page>
                        <page name="version_info" string="Validación y versión">
                            <group col="4">
                                <group colspan="4">
                                    <field name="version"
                                           attrs="{'readonly': [('state','in',('validate_ok','cancel'))]}"/>
                                </group>
                                <group colspan="4">
                                    <separator string="Elaboración"/>
                                    <field name="elaboration_step" colspan="4" nolabel="1"
                                           attrs="{'readonly': [('state','not in',('elaborate'))]}"/>
                                    <separator string="Revisión"/>
                                    <field name="review_step" colspan="4" nolabel="1"
                                           attrs="{'readonly': [('state','not in',('elaborate', 'review'))]}"/>
                                    <separator string="Validación"/>
                                    <field name="validation_step" colspan="4" nolabel="1"
                                           attrs="{'readonly': [('state','not in',('elaborate', 'review', 'validate'))]}"/>
                                </group>
                                <group colspan="2">
                                    <field name="date_elaborate"
                                           attrs="{'required': [('state','in',('elaborate'))], 'readonly': True}"/>
                                    <field name="date_review"
                                           attrs="{'required': [('state','in',('review'))], 'readonly': True, 'invisible': [('state','in',('elaborate'))] }"/>
                                    <field name="date_validate" groups="base.group_no_one,base.user_admin"
                                           attrs="{'invisible': [('state','in',('elaborate','review'))] }"/>
                                </group>
                            </group>
                        </page>
                        <page name="multi_company" string="Multi compañia">
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sga_ideaa_matrix_view_tree" model="ir.ui.view">
        <field name="name">sga.ideaa_matrix.view.tree</field>
        <field name="model">sga.ideaa_matrix</field>
        <field name="arch" type="xml">
            <tree string="Matriz">
                <field name="name"/>
                <field name="state"/>
                <field name="date_elaborate"/>
                <field name="elaboration_step" widget="many2many_tags"/>
                <field name="version"/>
                <field name="company_id"
       groups="base.group_multi_company"/>

            </tree>
        </field>
    </record>

    <record id="sga_ideaa_matrix_action" model="ir.actions.act_window">
        <field name="name">Matriz IDEAA</field>
        <field name="res_model">sga.ideaa_matrix</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <!--        <field name="context" eval="{'default_evaluation_id':ref('soyseguridad_risk.evaluation_main')}" />-->
        <field name="help" type="html">
            <p>MATRIZ DE IDENTIFICACIÓN DE ASPECTOS AMBIENTALES</p>
        </field>
    </record>

    <record id="sga_matrix_aspect_action" model="ir.actions.act_window">
        <field name="name">Aspectos</field>
        <field name="res_model">sga.matrix.aspect</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sga_matrix_impact_action" model="ir.actions.act_window">
        <field name="name">Impactos</field>
        <field name="res_model">sga.matrix.impact</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
