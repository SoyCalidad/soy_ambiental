<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sst_contigency_plan_view_form" model="ir.ui.view">
        <field name="name">sst.contigency_plan.view.form.inherit</field>
        <field name="model">sst.contigency_plan</field>
        <field name="inherit_id" ref="soyseguridad_contigency_plan.sst_contigency_plan_view_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <field name="is_sga_context" invisible="1"/>

            </sheet>
            
        </field>
    </record>

    <record id="sst_contigency_plan_action" model="ir.actions.act_window">
        <field name="name">Plan de contingencia</field>
        <field name="res_model">sst.contigency_plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_sga_context': True}</field>
    </record>
</odoo>
